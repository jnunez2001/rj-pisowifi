# Internal roadmap/tab-map/design-reference docs (Workstreams 0-13 planning) -
# same reasoning as the plan docs above: dev-facing architecture notes, not
# something that should ship to a client device or be visible in a public
# repo history.
docs/

# Raw planning/brand-source material - not runtime code, never pushed. The
# app's own logo copies live in public/admin/img/ (tracked normally); this
# folder is the unprocessed source bible/assets, kept local-only.
zentry assets/

# Separate app with its own future GitHub repo (per ZENFI_ROADMAP_PLAN.md) -
# doesn't belong in this repo's history at all, tracked or not. Renamed
# from zenfi-beta-portal to zentry-hub (2026-08-03) - this is meant to
# grow into the shared Zentry account hub across all products (ZenFi,
# ZenCafe, ZenPOS...), not stay ZenFi/beta-specific.
zentry-hub/

# Nothing AI-tool-related ships in this repo's history - the codebase and
# commit history should read as hand-written, not AI-assisted.
CLAUDE.md
.claude/
.DS_Store

# Internal architecture/handoff docs - same reasoning as the *_PLAN.md files
# above: dev-facing notes, not something that should ship to a client
# device or be visible in a public repo history.
ZENTRY-ZENFI-DEVELOPER-HANDOFF-v2/

# Local mini-PC provisioning material - contains a temp-password hash for
# first-boot cloud-init, kept local-only rather than in repo history.
setup/mini-pc-autoinstall/

# Local movie server's transcoded HLS output (server/services/
# movieService.js) - generated per-box from the operator's own movies
# folder, large binary video segments, never belongs in repo history.
public/movies_cache/

# dotnet build output for the Windows rental client - regenerated by
# `dotnet build`/`dotnet publish`, never source.
windows-rental-client/bin/
windows-rental-client/obj/
